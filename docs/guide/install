#!/usr/bin/env sh
# MEML CLI installer for macOS & Linux.
#
# Usage:
#   curl -fsSL https://mindon.dev/meml/install | bash
#   curl -fsSL https://mindon.dev/meml/install | bash -s -- <version>
#
# Installs the `meml` binary into ~/.meml/bin and adds it to your shell PATH.

set -eu

REPO="mindon/meml"
BASE_DIR="${MEML_INSTALL_DIR:-$HOME/.meml}"
BIN_DIR="$BASE_DIR/bin"
VERSION="${1:-latest}"

# ---------- helpers ----------
info()    { printf '\033[1;36m[meml]\033[0m %s\n' "$*"; }
success() { printf '\033[1;32m[meml]\033[0m %s\n' "$*"; }
warn()    { printf '\033[1;33m[meml]\033[0m %s\n' "$*" >&2; }
error()   { printf '\033[1;31m[meml]\033[0m %s\n' "$*" >&2; }

# ---------- platform detection ----------
OS="$(uname -s)"
ARCH="$(uname -m)"

case "$OS" in
  Darwin) OS_NAME="macos" ;;
  Linux)  OS_NAME="linux" ;;
  *)
    error "Unsupported operating system: $OS"
    exit 1
    ;;
esac

case "$ARCH" in
  x86_64 | amd64) ARCH_NAME="x86_64" ;;
  aarch64 | arm64) ARCH_NAME="aarch64" ;;
  *)
    error "Unsupported architecture: $ARCH"
    exit 1
    ;;
esac

ASSET="meml-${ARCH_NAME}-${OS_NAME}.tar.gz"

if [ "$VERSION" = "latest" ]; then
  URL="https://github.com/$REPO/releases/latest/download/$ASSET"
else
  URL="https://github.com/$REPO/releases/download/$VERSION/$ASSET"
fi

# ---------- download ----------
info "Downloading $ASSET ..."
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

if command -v curl >/dev/null 2>&1; then
  if ! curl -fsSL "$URL" -o "$TMP_DIR/$ASSET"; then
    error "Download failed. Check the version tag or your network."
    exit 1
  fi
elif command -v wget >/dev/null 2>&1; then
  if ! wget -q "$URL" -O "$TMP_DIR/$ASSET"; then
    error "Download failed. Check the version tag or your network."
    exit 1
  fi
else
  error "Neither curl nor wget is available. Install one of them and retry."
  exit 1
fi

# ---------- extract & install ----------
info "Installing to $BIN_DIR ..."
tar -xzf "$TMP_DIR/$ASSET" -C "$TMP_DIR"

mkdir -p "$BIN_DIR"
install -m 0755 "$TMP_DIR/meml" "$BIN_DIR/meml"

# Smoke test: MEML CLI has no --version flag; --help returns the usage text.
if "$BIN_DIR/meml" --help >/dev/null 2>&1; then
  success "Installed meml -> $BIN_DIR/meml"
else
  warn "Installed binary but self-check failed. Please inspect $BIN_DIR/meml manually."
fi

# ---------- add to PATH ----------
add_path_line() {
  LINE='export PATH="$HOME/.meml/bin:$PATH"'
  FILE="$1"
  [ -f "$FILE" ] || touch "$FILE"
  if ! grep -Fq '.meml/bin' "$FILE" 2>/dev/null; then
    printf '\n%s\n' "$LINE" >> "$FILE"
    info "Added PATH entry to $FILE"
  else
    info "PATH entry already present in $FILE"
  fi
}

CURRENT_SHELL="$(basename "${SHELL:-}")"
case "$CURRENT_SHELL" in
  zsh)
    add_path_line "$HOME/.zshrc"
    ;;
  fish)
    FILE="$HOME/.config/fish/config.fish"
    LINE='fish_add_path "$HOME/.meml/bin"'
    mkdir -p "$(dirname "$FILE")"
    [ -f "$FILE" ] || touch "$FILE"
    if ! grep -Fq '.meml/bin' "$FILE" 2>/dev/null; then
      printf '\n%s\n' "$LINE" >> "$FILE"
      info "Added PATH entry to $FILE"
    else
      info "PATH entry already present in $FILE"
    fi
    ;;
  bash)
    add_path_line "$HOME/.bashrc"
    ;;
  *)
    add_path_line "$HOME/.profile"
    ;;
esac

# ---------- done ----------
printf '\n'
success "MEML CLI installed successfully."
printf '\n'
info "To use it in this terminal, run:"
printf '  source ~/.zshrc   # or the rc file that was updated\n\n'
info "Try it out:"
printf "  meml --help\n"
printf "  meml '{\"op\":\"ping\"}'\n"
printf '\n'
info "Docs & integrations: https://github.com/mindon/meml"
