#!/usr/bin/env sh
# MEML agent integration installer for macOS and Linux.
#
# Usage:
#   curl -fsSL https://mindon.dev/meml/install-plugin | bash
#   curl -fsSL https://mindon.dev/meml/install-plugin | bash -s -- v0.1.0
#
# Installs integrations atomically into ~/.meml/integrations. It registers the
# read-only MCP server with CodeBuddy when the CLI is available, and prepares
# a standard plugin root for CodeBuddy and WorkBuddy.

set -eu
umask 077

REF="${1:-main}"
BASE_DIR="${MEML_INSTALL_DIR:-$HOME/.meml}"
INTEGRATIONS_DIR="$BASE_DIR/integrations"
# GitHub accepts a branch, tag, or commit SHA in this archive URL.
ARCHIVE_URL="https://codeload.github.com/mindon/meml/tar.gz/$REF"

info()    { printf '\033[1;36m[meml-plugin]\033[0m %s\n' "$*"; }
success() { printf '\033[1;32m[meml-plugin]\033[0m %s\n' "$*"; }
warn()   { printf '\033[1;33m[meml-plugin]\033[0m %s\n' "$*" >&2; }
error()  { printf '\033[1;31m[meml-plugin]\033[0m %s\n' "$*" >&2; }

case "$REF" in
  ""|*".."*|*" "*|*"\""*|*"'"*)
    error "Invalid git ref: $REF"
    exit 1
    ;;
esac
case "$BASE_DIR" in
  ""|/|/tmp|/var|/usr|/etc|/System|"$HOME")
    error "Refusing to use an unsafe MEML_INSTALL_DIR: $BASE_DIR"
    exit 1
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  error "Node.js is required to run the MEML MCP bridge. Install Node.js and retry."
  exit 1
fi

if [ -x "$BASE_DIR/bin/meml" ]; then
  MEML_BIN="$BASE_DIR/bin/meml"
elif command -v meml >/dev/null 2>&1; then
  MEML_BIN="$(command -v meml)"
else
  error "meml CLI not found. Install it first:"
  error "  curl -fsSL https://mindon.dev/meml/install | bash"
  exit 1
fi
if [ ! -f "$MEML_BIN" ] || [ ! -x "$MEML_BIN" ]; then
  error "meml is not an executable file: $MEML_BIN"
  exit 1
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/meml-plugin.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT
ARCHIVE="$TMP_DIR/meml.tar.gz"

info "Downloading integrations ($REF) ..."
if command -v curl >/dev/null 2>&1; then
  curl -fsSL --proto '=https' --tlsv1.2 "$ARCHIVE_URL" -o "$ARCHIVE"
elif command -v wget >/dev/null 2>&1; then
  wget -q "$ARCHIVE_URL" -O "$ARCHIVE"
else
  error "Neither curl nor wget is available. Install one and retry."
  exit 1
fi

tar -tzf "$ARCHIVE" >/dev/null

tar -xzf "$ARCHIVE" -C "$TMP_DIR"
SRC_DIR="$(find "$TMP_DIR" -mindepth 1 -maxdepth 1 -type d -name 'meml-*' -print -quit)"
if [ -z "$SRC_DIR" ] || [ ! -d "$SRC_DIR/integrations" ] || [ ! -f "$SRC_DIR/integrations/mcp/meml-mcp.mjs" ]; then
  error "Downloaded archive does not contain a valid MEML integrations tree."
  exit 1
fi

# Stage the complete tree before touching the active installation. Keep the
# previous tree as a rollback copy instead of deleting it during an update.
mkdir -p "$BASE_DIR"
STAGE_DIR="$BASE_DIR/.integrations.install.$$"
if [ -e "$STAGE_DIR" ]; then
  error "Temporary installation path already exists: $STAGE_DIR"
  exit 1
fi
mkdir -p "$STAGE_DIR"
cp -R "$SRC_DIR/integrations" "$STAGE_DIR/integrations"

BACKUP_DIR="$BASE_DIR/integrations.previous.$$"
if [ -e "$INTEGRATIONS_DIR" ]; then
  if [ -e "$BACKUP_DIR" ]; then
    error "Rollback path already exists: $BACKUP_DIR"
    exit 1
  fi
  mv "$INTEGRATIONS_DIR" "$BACKUP_DIR"
fi
if ! mv "$STAGE_DIR/integrations" "$INTEGRATIONS_DIR"; then
  if [ -e "$BACKUP_DIR" ]; then mv "$BACKUP_DIR" "$INTEGRATIONS_DIR"; fi
  error "Could not activate the new integrations tree."
  exit 1
fi
rmdir "$STAGE_DIR" 2>/dev/null || true
chmod 700 "$BASE_DIR" "$INTEGRATIONS_DIR"
success "Installed integrations -> $INTEGRATIONS_DIR"
if [ -e "$BACKUP_DIR" ]; then
  info "Previous installation kept for rollback at $BACKUP_DIR"
fi

MCP_SCRIPT="$INTEGRATIONS_DIR/mcp/meml-mcp.mjs"
CODEBUDDY_PLUGIN_DIR="$INTEGRATIONS_DIR/codebuddy/meml-plugin"
WORKBUDDY_PLUGIN_DIR="${MEML_WORKBUDDY_PLUGIN_DIR:-$CODEBUDDY_PLUGIN_DIR}"
mkdir -p "$BASE_DIR/state"
chmod 700 "$BASE_DIR/state"

# Produce a valid JSON/TOML string without interpolating a path into syntax.
json_quote() {
  node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' "$1"
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

printf '\n'

# CodeBuddy has a documented MCP CLI. add-json keeps paths and environment
# values correctly escaped and makes the operation repeatable by server name.
if command -v codebuddy >/dev/null 2>&1; then
  info "CodeBuddy detected — registering the meml MCP server ..."
  MCP_JSON="$(MEML_BIN="$MEML_BIN" MEML_SCRIPT="$MCP_SCRIPT" MEML_STATE="$BASE_DIR/state/codebuddy.state" node -e '
    process.stdout.write(JSON.stringify({
      type: "stdio",
      command: "node",
      args: [process.env.MEML_SCRIPT],
      env: {
        MEML_BIN: process.env.MEML_BIN,
        MEML_STATE_PATH: process.env.MEML_STATE,
        MEML_ACTOR: "codebuddy",
        MEML_RECEIPT_PREFIX: "codebuddy-verified-"
      }
    }));
  ')"
  if codebuddy mcp add-json --scope user meml "$MCP_JSON" 2>/dev/null; then
    success "Registered meml MCP server for CodeBuddy (user scope)."
  else
    warn "CodeBuddy MCP registration was not changed. Run this command manually if needed:"
    printf '  codebuddy mcp add-json --scope user meml %s\n' "$(shell_quote "$MCP_JSON")"
  fi
else
  warn "CodeBuddy CLI not detected. Load the plugin with:"
  printf '  codebuddy --plugin-dir %s\n' "$(shell_quote "$CODEBUDDY_PLUGIN_DIR")"
  info "The plugin includes .codebuddy-plugin/plugin.json, .mcp.json and skills/."
fi

# WorkBuddy uses the compatible plugin layout. Its installation/cache policy
# is host-managed, so do not edit undocumented global files automatically.
if command -v workbuddy >/dev/null 2>&1; then
  success "WorkBuddy detected. Load this local plugin directory:"
else
  info "WorkBuddy plugin prepared at:"
fi
printf '  %s\n' "$(shell_quote "$WORKBUDDY_PLUGIN_DIR")"
info "If your WorkBuddy CLI accepts local plugins, run:"
printf '  workbuddy --plugin-dir %s\n' "$(shell_quote "$WORKBUDDY_PLUGIN_DIR")"

# Claude Code remains directly configurable through its documented MCP CLI.
if command -v claude >/dev/null 2>&1; then
  info "Claude Code detected — registering the meml MCP server ..."
  if claude mcp add --scope user --transport stdio \
       --env "MEML_BIN=$MEML_BIN" \
       --env "MEML_STATE_PATH=$BASE_DIR/state/claude-code.state" \
       meml -- node "$MCP_SCRIPT" 2>/dev/null; then
    success "Registered meml MCP server for Claude Code (user scope)."
  else
    warn "Could not update Claude Code automatically. Use the plugin instead:"
    printf '  claude --plugin-dir %s\n' "$(shell_quote "$INTEGRATIONS_DIR/claude-code/meml-plugin")"
  fi
fi

# Codex uses TOML. JSON quoting is valid for TOML basic strings and avoids
# malformed configuration when a path contains spaces or special characters.
CODEX_CFG="$HOME/.codex/config.toml"
toml_quote() { json_quote "$1"; }
if [ -d "$HOME/.codex" ]; then
  if grep -q '^\[mcp_servers.meml\]' "$CODEX_CFG" 2>/dev/null; then
    info "Codex already has a [mcp_servers.meml] entry; leaving it unchanged."
  else
    info "Codex detected — appending the meml MCP block to $CODEX_CFG ..."
    {
      printf '\n[mcp_servers.meml]\n'
      printf 'command = "node"\n'
      printf 'args = [%s]\n' "$(toml_quote "$MCP_SCRIPT")"
      printf 'startup_timeout_sec = 20\n'
      printf 'tool_timeout_sec = 30\n'
      printf 'enabled_tools = ["meml_recall"]\n'
      printf 'default_tools_approval_mode = "approve"\n'
      printf '\n[mcp_servers.meml.env]\n'
      printf 'MEML_BIN = %s\n' "$(toml_quote "$MEML_BIN")"
      printf 'MEML_STATE_PATH = %s\n' "$(toml_quote "$BASE_DIR/state/codex.state")"
      printf 'MEML_ACTOR = "codex"\n'
      printf 'MEML_RECEIPT_PREFIX = "codex-verified-"\n'
    } >> "$CODEX_CFG"
    success "Appended the meml MCP block for Codex."
  fi
fi

printf '\n'
success "Integrations installed. Install the Skill too for in-agent memory guidance:"
info "  curl -fsSL https://mindon.dev/meml/install-skill | bash"
info "Docs: https://github.com/mindon/meml/tree/main/integrations"
