#!/usr/bin/env sh
# MEML agent-memory Skill installer for macOS and Linux.
#
# Usage:
#   curl -fsSL https://mindon.dev/meml/install-skill | bash
#   curl -fsSL https://mindon.dev/meml/install-skill | bash -s -- main
#
# The Skill is kept in ~/.meml/skills. If CodeBuddy or WorkBuddy is present,
# it is also placed in the shared local plugin's skills/ directory.

set -eu
umask 077

SKILL_NAME="meml-agent-memory"
REF="${1:-main}"
BASE_DIR="${MEML_INSTALL_DIR:-$HOME/.meml}"
SKILL_DIR="$BASE_DIR/skills/$SKILL_NAME"
RAW_URL="https://raw.githubusercontent.com/mindon/meml/$REF/integrations/skills/$SKILL_NAME/SKILL.md"

info()    { printf '\033[1;36m[meml-skill]\033[0m %s\n' "$*"; }
success() { printf '\033[1;32m[meml-skill]\033[0m %s\n' "$*"; }
warn()   { printf '\033[1;33m[meml-skill]\033[0m %s\n' "$*" >&2; }
error()  { printf '\033[1;31m[meml-skill]\033[0m %s\n' "$*" >&2; }

case "$REF" in
  ""|*".."*|*" "*|*"\""*|*"'"*)
    error "Invalid git ref: $REF"
    exit 1
    ;;
esac
case "$BASE_DIR" in
  ""|/|/tmp|/var|/usr|/etc|/System|"$HOME")
    error "Refusing to use an unsafe MEML_INSTALL_DIR: $BASE_DIR"
    exit 1
    ;;
esac

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/meml-skill.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT
DOWNLOADED="$TMP_DIR/SKILL.md"

info "Downloading $SKILL_NAME ($REF) ..."
if command -v curl >/dev/null 2>&1; then
  curl -fsSL --proto '=https' --tlsv1.2 "$RAW_URL" -o "$DOWNLOADED"
elif command -v wget >/dev/null 2>&1; then
  wget -q "$RAW_URL" -O "$DOWNLOADED"
else
  error "Neither curl nor wget is available. Install one and retry."
  exit 1
fi

if [ ! -s "$DOWNLOADED" ] || ! grep -q '^name: meml-agent-memory$' "$DOWNLOADED" || ! grep -q '^description:' "$DOWNLOADED"; then
  error "Downloaded file is not a valid MEML Skill."
  exit 1
fi

install_skill_to() {
  DEST_ROOT="$1"
  DEST="$DEST_ROOT/$SKILL_NAME"
  mkdir -p "$DEST"
  cp "$DOWNLOADED" "$DEST/SKILL.md"
  chmod 600 "$DEST/SKILL.md"
  success "Installed Skill -> $DEST/SKILL.md"
}

# Always keep a stable local copy for later plugin installation.
install_skill_to "$BASE_DIR/skills"

# CodeBuddy and WorkBuddy load Skills from a plugin root, not a bare global
# skills directory. The shared plugin is installed by install-plugin; this
# command also makes its Skill available when the host is already installed.
CODEBUDDY_PLUGIN_DIR="${MEML_CODEBUDDY_PLUGIN_DIR:-$BASE_DIR/integrations/codebuddy/meml-plugin}"
WORKBUDDY_PLUGIN_DIR="${MEML_WORKBUDDY_PLUGIN_DIR:-$BASE_DIR/integrations/codebuddy/meml-plugin}"

if [ -n "${MEML_CODEBUDDY_PLUGIN_DIR:-}" ] || command -v codebuddy >/dev/null 2>&1; then
  install_skill_to "$CODEBUDDY_PLUGIN_DIR/skills"
  info "Load it in CodeBuddy with: codebuddy --plugin-dir \"$CODEBUDDY_PLUGIN_DIR\""
fi

if [ -n "${MEML_WORKBUDDY_PLUGIN_DIR:-}" ] || command -v workbuddy >/dev/null 2>&1; then
  if [ "$WORKBUDDY_PLUGIN_DIR" != "$CODEBUDDY_PLUGIN_DIR" ]; then
    install_skill_to "$WORKBUDDY_PLUGIN_DIR/skills"
  else
    info "WorkBuddy will reuse the shared plugin at $WORKBUDDY_PLUGIN_DIR"
  fi
  info "Load it in WorkBuddy from the local plugin directory: $WORKBUDDY_PLUGIN_DIR"
fi

# Existing host-specific skill locations remain supported.
if [ -d "$HOME/.pi" ]; then install_skill_to "$HOME/.pi/skills"; fi
if [ -d "$HOME/.agents" ]; then install_skill_to "$HOME/.agents/skills"; fi
if [ -d "$HOME/.claude" ]; then install_skill_to "$HOME/.claude/skills"; fi
if [ -d ".dsh" ]; then install_skill_to ".dsh/skills"; fi

printf '\n'
success "MEML Skill installed."
info "To install the matching MCP plugin for CodeBuddy/WorkBuddy and other hosts:"
info "  curl -fsSL https://mindon.dev/meml/install-plugin | bash"
info "Source: https://github.com/mindon/meml/tree/main/integrations"
